WarningsAsErrors: ""
HeaderFilterRegex: "^src/"
FormatStyle: file

Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  clang-diagnostic-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-uppercase-literal-suffix,
  -misc-use-internal-linkage,
